MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:4b
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=ollama
MODEL_TIMEOUT_SECONDS=240
# 真实 RAG：安装 python -m pip install -e ".[rag]" 后将 legacy 改为 embedding。
# Embedding 与 DeepSeek 对话模型独立；使用外部服务会发送仓库代码块，请确认隐私要求。
RAG_RETRIEVAL_MODE=legacy
RAG_VECTOR_ROOT=runtime/vectors
# API/Celery 多进程必须通过 Chroma 服务访问；先运行 scripts/start-chroma.ps1
RAG_CHROMA_URL=http://127.0.0.1:8001
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT_SECONDS=60
# OpenAI-compatible: EMBEDDING_PROVIDER=openai，BASE_URL 填含 /v1 的服务根地址
# EMBEDDING_API_KEY=仅放在本地环境变量或未提交的 .env 中
# EMBEDDING_DIMENSIONS=可选，模型支持时才填写；修改后使用新向量空间
AGENT_ALLOWED_REPOSITORY_ROOTS=E:\aiTraval

# 后台执行：Redis 运行在 WSL Docker，API/Celery Worker 运行在 Windows
EXECUTION_BACKEND=celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Figma Desktop MCP；在 Figma Dev Mode 中启用后使用
# FIGMA_MCP_URL=http://127.0.0.1:3845/mcp

# DeepSeek API（启用时替换上面的 MODEL_PROVIDER / MODEL_NAME / MODEL_BASE_URL）
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-flash
# MODEL_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=请仅在本地环境变量中设置，不要提交真实密钥
