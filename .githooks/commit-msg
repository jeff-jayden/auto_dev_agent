#!/usr/bin/env python
from pathlib import Path
import sys


message_path = Path(sys.argv[1])
subject = message_path.read_text(encoding="utf-8", errors="replace").splitlines()[0].strip()
if not any("\u4e00" <= character <= "\u9fff" for character in subject):
    print("提交失败：提交信息首行必须包含中文。", file=sys.stderr)
    raise SystemExit(1)
